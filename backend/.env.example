# Database Connection String
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=HireConnectDB;User=root;Password=;

# JWT Authentication Configuration
Jwt__Key=NewSuperSecretRandomKeyForHireConnect2026ThatIsOver32CharsLong!
Jwt__Issuer=HireConnectAPI
Jwt__Audience=HireConnectClient
Jwt__ExpireMinutes=15
Jwt__RefreshExpireDays=7
