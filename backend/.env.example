# Database Connection String
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=HireConnectDB;User=root;Password=;

# JWT Authentication Configuration
Jwt__Key=CHANGE_ME_MIN_32_CHARS
Jwt__Issuer=HireConnectAPI
Jwt__Audience=HireConnectClient
Jwt__ExpireMinutes=15
Jwt__RefreshExpireDays=7

# Security Configuration
Security__IpHashSalt=CHANGE_ME_MIN_32_CHARS_SECRET_SALT

# Initial Admin Credentials (Optional - admin is not created if empty)
Admin__Email=
Admin__Password=

# Email / SMTP Configuration
EmailSettings__SmtpHost=
EmailSettings__SmtpPort=587
EmailSettings__SmtpUsername=
EmailSettings__SmtpPassword=
EmailSettings__SenderEmail=noreply@hireconnect.com
EmailSettings__SenderName=HireConnect
EmailSettings__EnableSsl=true
EmailSettings__DevPrintTokenToConsole=false

# PayHere Payment Gateway Configuration
PayHere__MerchantId=
PayHere__MerchantSecret=

# Refresh Token Cookie Settings
# Local development (HTTP): SameSite=Lax, Secure=false
# Production cross-domain (HTTPS): SameSite=None, Secure=true
CookieSettings__SameSite=Lax
CookieSettings__Secure=false
