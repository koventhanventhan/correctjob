# ==========================================
# HireConnect API - Production Environment Configuration
# ==========================================
# All variables should be provided via environment variables in production or a secure vault.
# In production, startup will fail immediately if any required keys are missing or contain placeholder values.

# Database Connection String (MySQL 8.0+)
ConnectionStrings__DefaultConnection=Server=your-db-host;Port=3306;Database=HireConnectDB;User=your_db_user;Password=your_secure_db_password;

# JWT Authentication Configuration
# Key must be a cryptographically strong secret of at least 32 characters
Jwt__Key=your-strong-cryptographic-jwt-secret-min-32-chars
Jwt__Issuer=HireConnectAPI
Jwt__Audience=HireConnectClient
Jwt__ExpireMinutes=15
Jwt__RefreshExpireDays=7

# Security & Privacy Salt
# Must be a 32+ character secret used for hashing client IPs in audit logs
Security__IpHashSalt=your-strong-ip-hashing-secret-salt-min-32-chars

# Initial Administrator Account
# Seeded automatically upon first startup if not already created
Admin__Email=admin@hireconnect.com
Admin__Password=YourStrongAdminPassword123!

# Email / SMTP Configuration
EmailSettings__SmtpHost=smtp.your-mail-provider.com
EmailSettings__SmtpPort=587
EmailSettings__SmtpUsername=smtp-user@your-domain.com
EmailSettings__SmtpPassword=your-smtp-password
EmailSettings__SenderEmail=noreply@hireconnect.com
EmailSettings__SenderName=HireConnect
EmailSettings__EnableSsl=true
EmailSettings__DevPrintTokenToConsole=false

# PayHere Payment Gateway Configuration
PayHere__MerchantId=your_payhere_merchant_id
PayHere__MerchantSecret=your_payhere_merchant_secret
PayHere__NotifyUrl=https://api.hireconnect.com/api/payments/notify
PayHere__ReturnUrl=https://hireconnect.com/employer/payment-success
PayHere__CancelUrl=https://hireconnect.com/employer/payment-cancelled
PayHere__IsSandbox=false

# Refresh Token Cookie Settings
# Local development (HTTP): SameSite=Lax, Secure=false
# Production cross-domain (HTTPS): SameSite=None, Secure=true
CookieSettings__SameSite=None
CookieSettings__Secure=true

# Frontend URL & CORS Allowed Origins
# Specify exact production domain(s) without wildcards
FrontendUrl=https://hireconnect.com
Cors__AllowedOrigins__0=https://hireconnect.com
Cors__AllowedOrigins__1=https://www.hireconnect.com
