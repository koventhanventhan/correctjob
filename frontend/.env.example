# ==========================================
# HireConnect Frontend - Environment Configuration
# ==========================================

# Public API URL pointing to the ASP.NET Core Backend
# Development: http://localhost:5189/api
# Production: https://api.hireconnect.lk/api (or custom domain)
NEXT_PUBLIC_API_URL=https://api.hireconnect.lk/api

# Base Production/Site URL used for metadataBase, canonical URLs, sitemaps, and OpenGraph
# Development: http://localhost:3000 (auto-fallback if not set)
# Production: https://hireconnect.lk
# IMPORTANT: In production (NODE_ENV=production), NEXT_PUBLIC_SITE_URL is strictly MANDATORY!
# getSiteUrl() will intentionally throw a build error if missing in production to prevent deploying broken localhost metadata.
NEXT_PUBLIC_SITE_URL=https://hireconnect.lk
